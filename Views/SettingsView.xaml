<UserControl x:Class="UsersApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F4F0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Налаштування" FontSize="26" FontWeight="SemiBold"
                       Foreground="#47352B" Margin="0,0,0,20" />
            <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Інформація про салон" FontSize="18" FontWeight="SemiBold" Foreground="#47352B" />
                    <TextBlock Text="Назва салону: не налаштовано" Foreground="#65584F" Margin="0,14,0,4" />
                    <TextBlock Text="Контактний номер телефону: не налаштовано" Foreground="#65584F" Margin="0,4" />
                    <TextBlock Text="Адреса: не налаштовано" Foreground="#65584F" Margin="0,4" />
                    <TextBlock Text="У програмі немає сховища для цих даних, тому вони не редагуються та не зберігаються."
                               Foreground="#7D7168" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Оформлення" FontSize="18" FontWeight="SemiBold" Foreground="#47352B" />
                    <TextBlock Text="Тема застосовується до вікна кабінету." Foreground="#7D7168" Margin="0,8,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightThemeRadio" Content="Світла" GroupName="Theme"
                                     Checked="LightTheme_Checked" Margin="0,0,24,0" />
                        <RadioButton x:Name="DarkThemeRadio" Content="Темна" GroupName="Theme"
                                     Checked="DarkTheme_Checked" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Про програму" FontSize="18" FontWeight="SemiBold" Foreground="#47352B" />
                    <TextBlock Text="BeautySalonAIS" FontSize="16" FontWeight="SemiBold" Foreground="#80614B" Margin="0,14,0,4" />
                    <TextBlock Text="Програма для керування клієнтами, послугами, майстрами та замовленнями салону краси."
                               Foreground="#65584F" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Foreground="#7D7168" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="Обліковий запис" FontSize="18" FontWeight="SemiBold" Foreground="#47352B" />
                    <TextBlock Text="Завершити поточний сеанс та повернутися до авторизації."
                               Foreground="#7D7168" Margin="0,8,0,14" TextWrapping="Wrap" />
                    <Button Content="Вийти з облікового запису" Click="Logout_Click"
                            HorizontalAlignment="Left" Padding="16,9" Background="#80614B"
                            Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
