<UserControl x:Class="UsersApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F4F0">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Розклад" FontSize="26" FontWeight="SemiBold" Foreground="#47352B" />
                <TextBlock Text="Календар замовлень салону" Foreground="#7D7168" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Додати замовлення" Click="AddOrder_Click"
                    Padding="18,10" Background="#80614B" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="‹" Click="PreviousMonth_Click" Padding="10,4" FontSize="20" />
                        <TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Foreground="#47352B" />
                        <Button Grid.Column="2" Content="›" Click="NextMonth_Click" Padding="10,4" FontSize="20" />
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,18,0,6">
                        <TextBlock Text="Пн" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Вт" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Ср" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Чт" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Пт" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Сб" HorizontalAlignment="Center" Foreground="#7D7168" />
                        <TextBlock Text="Нд" HorizontalAlignment="Center" Foreground="#7D7168" />
                    </UniformGrid>
                    <UniformGrid x:Name="CalendarGrid" Grid.Row="2" Columns="7" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Сьогодні" Click="Today_Click" Padding="12,6" />
                        <TextBlock Text="● замовлення" Foreground="#80614B" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedDateTitle" FontSize="19" FontWeight="SemiBold"
                               Foreground="#47352B" Margin="0,0,0,14" />
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OrdersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F7F4" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OrderTime}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="#80614B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" Foreground="#47352B" />
                                                    <TextBlock Text="{Binding ServiceName, StringFormat=Послуга: {0}}" Foreground="#65584F" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding MasterName, StringFormat=Майстер: {0}}" Foreground="#65584F" Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2} ₴}" FontWeight="SemiBold" Foreground="#47352B" />
                                                        <Border Background="#E9DED3" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Status}" Foreground="#47352B" FontSize="12" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="⋮" FontSize="20" Foreground="#47352B"
                                                        Background="Transparent" BorderThickness="0" Padding="8,2"
                                                        VerticalAlignment="Top" Click="OrderActionsButton_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Редагувати" Click="EditOrder_Click" />
                                                            <MenuItem Header="Видалити" Click="DeleteOrder_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Позначити як заплановано" Tag="Заплановано" Click="SetStatus_Click" />
                                                            <MenuItem Header="Позначити як у процесі" Tag="У процесі" Click="SetStatus_Click" />
                                                            <MenuItem Header="Позначити як виконано" Tag="Виконано" Click="SetStatus_Click" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyOrdersText" Text="На цю дату замовлень немає"
                                   Foreground="#7D7168" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="OrderEditorOverlay" Grid.ColumnSpan="3" Panel.ZIndex="10"
                  Background="#80000000" Visibility="Collapsed">
                <Border Width="480" MaxHeight="680" Padding="26" Background="White" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="EditorTitle" Text="Нове замовлення" FontSize="22"
                                       FontWeight="SemiBold" Foreground="#47352B" Margin="0,0,0,18" />
                            <TextBlock Text="Клієнт" FontWeight="SemiBold" Foreground="#59483E" />
                            <ComboBox x:Name="ClientComboBox" DisplayMemberPath="FullName" SelectedValuePath="ClientID" Margin="0,5,0,12" Padding="7" />
                            <TextBlock Text="Майстер" FontWeight="SemiBold" Foreground="#59483E" />
                            <ComboBox x:Name="MasterComboBox" DisplayMemberPath="FullName" SelectedValuePath="MasterID" Margin="0,5,0,12" Padding="7" />
                            <TextBlock Text="Послуга" FontWeight="SemiBold" Foreground="#59483E" />
                            <ComboBox x:Name="ServiceComboBox" DisplayMemberPath="ServiceName" SelectedValuePath="ServiceID"
                                      SelectionChanged="ServiceComboBox_SelectionChanged" Margin="0,5,0,12" Padding="7" />
                            <TextBlock Text="Дата замовлення" FontWeight="SemiBold" Foreground="#59483E" />
                            <Calendar x:Name="OrderDateCalendar" SelectionMode="SingleDate" Margin="0,5,0,12" />
                            <TextBlock Text="Час (ГГ:ХХ)" FontWeight="SemiBold" Foreground="#59483E" />
                            <TextBox x:Name="OrderTimeTextBox" MaxLength="5" Margin="0,5,0,12" Padding="7" />
                            <TextBlock Text="Вартість" FontWeight="SemiBold" Foreground="#59483E" />
                            <TextBlock x:Name="OrderPriceText" Text="Оберіть послугу" Foreground="#7D7168" Margin="0,5,0,12" />
                            <TextBlock Text="Статус" FontWeight="SemiBold" Foreground="#59483E" />
                            <ComboBox x:Name="StatusComboBox" Margin="0,5,0,12" Padding="7" />
                            <TextBlock x:Name="FormErrorText" Foreground="#A33B32" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Click="CancelOrder_Click" Margin="0,0,10,0" Padding="14,8" />
                                <Button x:Name="SaveButton" Content="Створити" Click="SaveOrder_Click"
                                        Background="#80614B" Foreground="White" BorderThickness="0" Padding="16,8" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
