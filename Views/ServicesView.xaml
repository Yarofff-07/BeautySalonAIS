<UserControl x:Class="UsersApp.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F4F0">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Керування послугами" FontSize="26" FontWeight="SemiBold"
                   Foreground="#47352B" Margin="0,0,0,20" />

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="searchTextBox" Height="38" MaxWidth="420" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" Padding="12,6"
                     TextChanged="SearchTextBox_TextChanged" ToolTip="Пошук за назвою послуги" />
            <Button Grid.Column="1" Content="Додати +" Click="AddService_Click"
                    Height="38" Padding="18,6" Background="#80614B" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" />
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12">
            <DataGrid x:Name="servicesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0" BorderThickness="0" Background="White"
                      AlternatingRowBackground="#FAF7F4" SelectionMode="Single"
                      SelectionUnit="FullRow" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding ServiceID}" Width="70" />
                    <DataGridTextColumn Header="Назва" Binding="{Binding ServiceName}" Width="2*" />
                    <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="1*" />
                    <DataGridTextColumn Header="Тривалість (хв)" Binding="{Binding Duration}" Width="1.3*" />
                    <DataGridTemplateColumn Header="Дії" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⋮" FontSize="18" Padding="8,0" MinWidth="38"
                                        Foreground="#47352B" Background="Transparent" BorderThickness="0"
                                        Click="ServiceActionsButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Редагувати" Click="EditService_Click"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Видалити" Click="DeleteService_Click"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid x:Name="serviceEditorOverlay" Grid.RowSpan="3" Panel.ZIndex="10"
              Background="#80000000" Visibility="Collapsed">
            <Border Width="480" Padding="28" Background="White" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="serviceEditorTitle" Text="Нова послуга" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#47352B" Margin="0,0,0,20" />

                        <TextBlock Text="Назва" FontWeight="SemiBold" Foreground="#59483E" />
                        <TextBox x:Name="serviceNameTextBox" Margin="0,6,0,14" Padding="8" />

                        <TextBlock Text="Опис" FontWeight="SemiBold" Foreground="#59483E" />
                        <TextBox x:Name="serviceDescriptionTextBox" Margin="0,6,0,14" Padding="8"
                                 Height="76" AcceptsReturn="True" TextWrapping="Wrap" />

                        <TextBlock Text="Вартість" FontWeight="SemiBold" Foreground="#59483E" />
                        <TextBox x:Name="servicePriceTextBox" Margin="0,6,0,14" Padding="8" />

                        <TextBlock Text="Тривалість у хвилинах" FontWeight="SemiBold" Foreground="#59483E" />
                        <TextBox x:Name="serviceDurationTextBox" Margin="0,6,0,14" Padding="8" />

                        <TextBlock x:Name="serviceFormErrorText" Foreground="#A33B32"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Скасувати" Click="CancelService_Click"
                                    Margin="0,0,10,0" Padding="14,8" />
                            <Button Content="Зберегти" Click="SaveService_Click"
                                    Background="#80614B" Foreground="White" BorderThickness="0"
                                    Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
